{
  // Debugging configurations for the server and its tests.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server",
      "env": {
        "PORT": "8080"
      }
    },
    {
      "name": "Debug the test under the cursor",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.run", "${selectedText}"]
    }
  ]
}
