# The service's variables, with the values a developer's machine runs with.
# Every value here is also the one the service assumes when the variable is
# unset, except where a line says otherwise.
#
# Copy this file to .env and change what you need: .env is never committed.
# Nothing reads .env by itself — the service reads its environment only — so
# export it into the shell before `just run`:
#
#   set -a; . ./.env; set +a; just run
#
# The debugger's configurations in .vscode/launch.json set their own values.

# The port the server listens on. Cloud Run sets it on every revision.
PORT=8080

# local or prod. Local switches on what development alone may do; Cloud Run,
# where K_SERVICE is set, refuses to start as local.
CANVAS_ENV=local

# debug, info, warn or error.
CANVAS_LOG_LEVEL=info

# json for a log collector, console to read by eye. The service assumes json
# when unset, and refuses console where K_SERVICE is set.
CANVAS_LOG_FORMAT=console

# How long the server waits for each part of a request, and how long it keeps
# an idle connection open.
CANVAS_HTTP_READ_HEADER_TIMEOUT=5s
CANVAS_HTTP_READ_TIMEOUT=30s
CANVAS_HTTP_WRITE_TIMEOUT=60s
CANVAS_HTTP_IDLE_TIMEOUT=120s

# The whole way out once a stop is asked for: three quarters for the requests
# in flight, a quarter for closing what the service ran on.
CANVAS_SHUTDOWN_TIMEOUT=9s
