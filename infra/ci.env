# What a workflow needs before it can sign in to Google, and therefore before
# there is any state to read it from: the two lines infra/bootstrap.sh prints.
#
# Neither is a secret. The provider is only usable by a token that satisfies
# its condition — this repository, under its owner's numeric id — and the
# identity behind it holds no key.

GCP_WORKLOAD_IDENTITY_PROVIDER=projects/796865465273/locations/global/workloadIdentityPools/canvas-api-github/providers/github
GCP_TERRAFORM_SERVICE_ACCOUNT=canvas-api-tf@mathtrail-canvas-prod.iam.gserviceaccount.com
