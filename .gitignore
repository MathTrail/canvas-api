# Secrets: a local .env, and the variants Vite also reads in web/ (.env.local,
# .env.production, .env.production.local and the like). The one env file meant
# to be committed is the example of the variables.
.env
.env.*
!.env.example

# Build and test output, and what a native or a profiling build leaves
bin/
dist/
coverage.*
*.out
*.coverprofile
profile.cov
*.test
*.exe
*.exe~
*.dll
*.so
*.dylib
*.prof

# Go workspace files: the service is one module, and it builds without a workspace
go.work
go.work.sum

# Node modules of the SPA (web/)
node_modules/

# The coverage of the SPA's tests, made anew by every run of them. The SPA's
# build lands in web/dist/, which dist/ above already keeps out.
/web/coverage/

# Terraform: downloaded providers, state, plans, and the values of one
# deployment. The provider lock file is committed and is not any of these.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
backend.hcl
crash.log
crash.*.log

# Working directory of the static analysis scanner.
.scannerwork/

# The credentials file Google's sign-in action writes into a workflow's
# checkout: short-lived, and never anything to commit.
gha-creds-*.json

# What the Firebase CLI leaves where it runs: the sums of the files it last
# published, and the log of a command that failed.
.firebase/
firebase-debug.log*
firebase-debug.*.log*

# Claude Code's settings of one person on one machine, such as the narrow
# permission of a live run, which is deleted once the run is over (CLAUDE.md).
.claude/settings.local.json

# Reference copies of other repositories: read-only material, never committed.
/reference/

# The one deployment this repository delivers to is described in the repository,
# not in somebody's console: these two are committed on purpose.
!infra/terraform/prod.auto.tfvars
!infra/terraform/backend.hcl
